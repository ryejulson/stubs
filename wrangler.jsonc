{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stubs",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "STUBS_DATA"
    }
  ]
}
